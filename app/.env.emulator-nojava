# Loaded by `npm run dev:emu:nojava` (vite --mode emulator-nojava).
# Auth emulator only; Firestore is replaced by an in-browser stand-in and
# reset codes are kept in server memory.
VITE_USE_EMULATORS=true
E2E_FAKE_FIRESTORE=true
OTP_STORE=memory
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-fridgewise
GCLOUD_PROJECT=demo-fridgewise
# Codes are printed in this terminal unless SMTP_* is set in .env.local,
# in which case they are really emailed.
