# Copy to .env.local and fill in. On Vercel, add the same names under
# Project Settings > Environment Variables.

# --- Browser (from Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false

# --- Server only (password-reset codes). Never prefix these with VITE_.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# SMTP for sending codes. Pick one:
# Gmail (no domain needed; needs 2-Step Verification and an app password
# from myaccount.google.com/apppasswords; about 500 emails a day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  (login + SMTP key from Brevo)
# Resend (needs a verified domain): SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
